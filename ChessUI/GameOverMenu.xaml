<UserControl x:Class="ChessUI.GameOverMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#CC000000">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="ResultText" FontSize="36" FontWeight="Bold" Foreground="White" TextAlignment="Center" Margin="10"/>
        <TextBlock x:Name="ReasonText" FontSize="20" Foreground="White" TextAlignment="Center" Margin="10"/>
        <Button Content="Restart" FontSize="20" Padding="20,10" Margin="10" Click="Restart_Click"/>
        <Button Content="Exit" FontSize="20" Padding="20,10" Margin="10" Click="Exit_Click"/>
    </StackPanel>
</UserControl>
